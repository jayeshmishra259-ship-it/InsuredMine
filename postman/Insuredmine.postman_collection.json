									"  pm.expect(body.statusCode).to.eql(200);\r",
									"  pm.expect(body.message).to.eql('Process metrics retrieved successfully');\r",
									"\r",
									"  pm.expect(body.data.processCpuPercent === null || typeof body.data.processCpuPercent === 'number').to.eql(true);\r",
