		{
			"name": "Policy imports",
			"item": [
				{
					"name": "Upload CSV or XLSX",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Import accepted', () => {",
									"  pm.expect(pm.response.code).to.equal(202);",
									"});",
									"",
									"const body = pm.response.json();",
									"",
									"pm.test('Response format is valid', () => {",
									"  pm.expect(body.success).to.equal(true);",
									"  pm.expect(body.data.jobId).to.be.a('string');",
									"});",
									"",
									"if (body.data?.jobId) {",
									"  pm.environment.set('importJobId', body.data.jobId);",
									"  console.log('Saved environment importJobId:', body.data.jobId);",
									"}"
								],
								"type": "text/javascript",
								"packages": {}
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"packages": {},
