NODE_ENV=development
PORT=3000
# Local Node.js: mongodb://127.0.0.1:27017/policy_import
# Docker Compose: mongodb://mongo:27017/policy_import
MONGODB_URI=mongodb://127.0.0.1:27017/policy_import
# Local Node.js: redis://127.0.0.1:6379
# Docker Compose: redis://redis:6379
REDIS_URL=redis://127.0.0.1:6379
UPLOAD_DIR=uploads
MAX_FILE_SIZE_BYTES=10485760
CPU_THRESHOLD=70
CPU_CHECK_INTERVAL_MS=5000
# Set to true only under a process manager/container that restarts an exited app.
RESTART_ON_HIGH_CPU=false
LOG_LEVEL=info
# Comma-separated web app origins. Leave blank only for local development.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
